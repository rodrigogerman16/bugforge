// BugForge core schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Platform {
  PC
  PLAYSTATION
  XBOX
  SWITCH
  MOBILE
}

enum BugSeverity {
  BLOCKER
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// Priority is deliberately a separate axis from BugSeverity: severity is the
// technical impact of the bug, priority is how urgently it should be worked —
// a Low-severity bug can be P0 (e.g. a typo on the store page) and a Blocker
// can be P4 if it only hits an internal debug build. Never derive one from
// the other.
enum BugPriority {
  P0
  P1
  P2
  P3
  P4
}

enum BugStatus {
  NEW
  CONFIRMED
  IN_PROGRESS
  FIXED
  READY_FOR_QA
  VERIFIED
  CLOSED
  REJECTED
  DUPLICATE
}

enum SessionStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TesterRole {
  QA_LEAD
  QA_ENGINEER
  DEVELOPER
  PRODUCER
}

model Game {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  coverColor  String    @default("#6366f1")
  releaseDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  platforms   GamePlatform[]
  builds      Build[]
  sessions    QASession[]
  bugs        Bug[]
  testCases   TestCase[]
}

// A game supports a subset of platforms, never assumed to be all of them —
// this join table is what makes "which platforms does this game support" a
// real, per-game fact instead of the single hardcoded value it used to be.
model GamePlatform {
  id       String   @id @default(cuid())
  platform Platform

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, platform])
}

enum BuildStatus {
  INTERNAL
  QA
  BETA
  RELEASE_CANDIDATE
  RELEASED
  DEPRECATED
}

model Build {
  id          String      @id @default(cuid())
  version     String
  branch      String      @default("main")
  status      BuildStatus @default(INTERNAL)
  notes       String?
  releasedAt  DateTime    @default(now())

  gameId      String
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)

  sessions    QASession[]
  bugs        Bug[]

  @@unique([gameId, version])
}

model QASession {
  id          String        @id @default(cuid())
  name        String
  status      SessionStatus @default(PLANNED)
  startedAt   DateTime?
  endedAt     DateTime?
  notes       String?
  createdAt   DateTime      @default(now())

  gameId      String
  game        Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)

  buildId     String
  build       Build         @relation(fields: [buildId], references: [id], onDelete: Cascade)

  bugs        Bug[]
  testRuns    TestRun[]
}

model Tester {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  role      TesterRole @default(QA_ENGINEER)
  avatarUrl String?
  createdAt DateTime   @default(now())

  reportedBugs Bug[]     @relation("ReportedBy")
  assignedBugs Bug[]     @relation("AssignedTo")
  testRuns     TestRun[]

  authoredComments Comment[]  @relation("CommentAuthor")
  mentionedIn      Comment[]  @relation("CommentMentions")
  reactions        Reaction[]

  activityAsActor  ActivityEvent[] @relation("ActivityActor")
  activityAsTarget ActivityEvent[] @relation("ActivityTarget")

  notifications Notification[] @relation("NotificationRecipient")
}

model Bug {
  id          String      @id @default(cuid())
  title       String
  description String
  severity    BugSeverity
  priority    BugPriority @default(P2)
  status      BugStatus   @default(NEW)
  isRegression Boolean    @default(false)
  // Which of the game's supported platforms this bug was found on — never
  // assume a game's whole platform lineup shares one bug list.
  platform    Platform    @default(PC)
  areaId      String?
  area        Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  stepsToReproduce String?
  expectedResult String?
  actualResult   String?
  map         String?
  gameMode    String?
  environmentOS  String?
  environmentGpu String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  gameId      String
  game        Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)

  buildId     String
  build       Build       @relation(fields: [buildId], references: [id], onDelete: Cascade)

  sessionId   String?
  session     QASession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  reportedById String?
  reportedBy   Tester?    @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   Tester?    @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  evidence    Evidence[]
  tags        Tag[]
  comments    Comment[]
  activity    ActivityEvent[]

  relationshipsAsSource BugRelationship[] @relation("RelationshipSource")
  relationshipsAsTarget BugRelationship[] @relation("RelationshipTarget")

  originatingTestRuns TestRun[] @relation("TestRunCreatedBug")
}

enum RelationshipType {
  DUPLICATE
  BLOCKS
  RELATED
  REGRESSION_OF
  CAUSED_BY
}

// Stored as one directional edge per link. sourceBug is the bug the
// relationship reads "from" (e.g. for BLOCKS, sourceBug is the blocker);
// the inverse label shown on targetBug's page is derived, never stored, so
// the two sides can never drift out of sync.
model BugRelationship {
  id        String           @id @default(cuid())
  type      RelationshipType
  createdAt DateTime         @default(now())

  sourceBugId String
  sourceBug   Bug    @relation("RelationshipSource", fields: [sourceBugId], references: [id], onDelete: Cascade)

  targetBugId String
  targetBug   Bug    @relation("RelationshipTarget", fields: [targetBugId], references: [id], onDelete: Cascade)

  @@unique([sourceBugId, targetBugId, type])
}

model Comment {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  editedAt  DateTime?

  bugId String
  bug   Bug    @relation(fields: [bugId], references: [id], onDelete: Cascade)

  authorId String
  author   Tester @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  // Self-relation for threaded replies — a null parentId is a top-level comment.
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  mentions    Tester[]            @relation("CommentMentions")
  reactions   Reaction[]
  attachments CommentAttachment[]
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String
  createdAt DateTime @default(now())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  testerId String
  tester   Tester @relation(fields: [testerId], references: [id], onDelete: Cascade)

  // One reaction per emoji per person — toggling re-clicks the same emoji.
  @@unique([commentId, testerId, emoji])
}

model CommentAttachment {
  id            String       @id @default(cuid())
  type          EvidenceType
  url           String
  fileName      String?
  fileSizeBytes Int?
  createdAt     DateTime     @default(now())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

enum ActivityEventType {
  BUG_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  SEVERITY_CHANGED
  ASSIGNED
  UNASSIGNED
  COMMENT_ADDED
}

model ActivityEvent {
  id        String            @id @default(cuid())
  type      ActivityEventType
  // For *_CHANGED events, the raw enum value strings (e.g. "IN_PROGRESS") —
  // resolved to display labels client-side via the existing meta maps.
  fromValue String?
  toValue   String?
  createdAt DateTime          @default(now())

  bugId String
  bug   Bug    @relation(fields: [bugId], references: [id], onDelete: Cascade)

  // Who performed the action.
  actorId String?
  actor   Tester? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  // For ASSIGNED/UNASSIGNED — the tester the bug was assigned to (or away from).
  targetTesterId String?
  targetTester   Tester? @relation("ActivityTarget", fields: [targetTesterId], references: [id], onDelete: SetNull)
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#898781")

  bugs  Bug[]
}

enum EvidenceType {
  IMAGE
  VIDEO
  LOG
  ATTACHMENT
}

model Evidence {
  id        String       @id @default(cuid())
  type      EvidenceType
  url       String
  // Inline text for LOG/ATTACHMENT items — lets the viewer render and
  // download real content without a separate file store.
  content   String?
  fileName  String?
  fileSizeBytes Int?
  caption   String?
  createdAt DateTime     @default(now())

  bugId     String
  bug       Bug          @relation(fields: [bugId], references: [id], onDelete: Cascade)
}

enum TestCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model TestCase {
  id            String           @id @default(cuid())
  title         String
  description   String?
  preconditions String?
  steps         String
  expected      String
  categoryId    String?
  category      Area?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  priority      TestCasePriority @default(MEDIUM)
  platform      Platform         @default(PC)
  createdAt     DateTime         @default(now())

  gameId        String
  game          Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)

  runs          TestRun[]
}

enum QADiscipline {
  GAMEPLAY
  UI
  AUDIO
  PERFORMANCE
  NETWORKING
  ACCESSIBILITY
  LOCALIZATION
}

// The real, user-manageable game-area taxonomy — replaces what used to be a
// hardcoded list. Custom areas are just new rows here; discipline is an
// optional higher-level grouping used only by the coverage page.
model Area {
  id         String        @id @default(cuid())
  name       String        @unique
  discipline QADiscipline?
  createdAt  DateTime      @default(now())

  bugs      Bug[]
  testCases TestCase[]
}

model TestRun {
  id         String    @id @default(cuid())
  result     String    // "PASS" | "FAIL" | "BLOCKED" | "SKIPPED" — for a
                        // step-by-step execution this is derived (worst of
                        // its TestStepResults), not independently editable.
  notes      String?
  runAt      DateTime  @default(now())

  testCaseId String
  testCase   TestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  sessionId  String
  session    QASession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  testerId   String?
  tester     Tester?   @relation(fields: [testerId], references: [id], onDelete: SetNull)

  stepResults TestStepResult[]

  // The bug this run auto-created on failure, if any — preserves the test
  // execution context a failed run led to, as a real FK rather than prose.
  createdBugId String?
  createdBug   Bug?    @relation("TestRunCreatedBug", fields: [createdBugId], references: [id], onDelete: SetNull)
}

model TestStepResult {
  id        String   @id @default(cuid())
  stepIndex Int
  // A snapshot of the step's wording at execution time, so editing the test
  // case later never rewrites what a past execution actually tested.
  stepText  String
  result    String   // "PASS" | "FAIL" | "BLOCKED" | "SKIPPED"
  notes     String?

  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)
}

enum QualityGateMetric {
  CRITICAL_BUGS
  TEST_PASS_RATE
  REGRESSION_RATE
  COVERAGE
  PERFORMANCE
}

enum GateOperator {
  LESS_THAN
  LESS_THAN_OR_EQUAL
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  EQUAL
}

enum NotificationType {
  BUG_ASSIGNED
  BUG_READY_FOR_QA
  BUILD_UPLOADED
  CRITICAL_BUG
  REGRESSION_DETECTED
  COMMENT_MENTION
}

// A real event, not a decorative bell icon — every row is created at the
// moment its underlying event actually happens (a bug gets assigned, a
// build gets uploaded, a regression relationship is created, ...). A null
// recipient is a team-wide event (everyone sees it); a set recipient is
// personal (e.g. "assigned to you") and only that tester sees it.
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  detail    String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  recipientId String?
  recipient   Tester? @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
}

// A configurable release requirement — e.g. "Test pass rate must be > 95%".
// The Release Readiness page (/builds/[id]/readiness) evaluates a build
// against every enabled gate here; editing a threshold on the Settings
// page changes what "ready to release" means everywhere, immediately —
// these rows are the actual gate, not just a description of one.
model QualityGate {
  id        String            @id @default(cuid())
  metric    QualityGateMetric @unique
  operator  GateOperator
  threshold Float
  enabled   Boolean           @default(true)
  updatedAt DateTime          @updatedAt
}
